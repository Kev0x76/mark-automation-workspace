{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mark-automation.local/schemas/generation_report.schema.json",
  "title": "generation_report.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "generated_at",
    "template_mode",
    "production_ready",
    "needs_v5_check",
    "generator",
    "template",
    "mode",
    "status",
    "inputs",
    "outputs",
    "summary",
    "rules",
    "items",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "template_mode": {
      "type": "string",
      "enum": ["kmt_style_v1", "kmt_style_v1_minimal", "kmt_style_v1_adaptive"]
    },
    "production_ready": {
      "type": "boolean",
      "const": false
    },
    "needs_v5_check": {
      "type": "boolean",
      "const": true
    },
    "generator": { "$ref": "#/$defs/tool" },
    "template": { "$ref": "#/$defs/template" },
    "mode": {
      "type": "string",
      "enum": ["preview", "standard"]
    },
    "status": {
      "type": "string",
      "enum": ["success", "success_with_warnings", "needs_review", "failed"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items_normalized", "manifest", "approved_linearts_dir"],
      "properties": {
        "items_normalized": { "$ref": "#/$defs/artifact" },
        "manifest": { "$ref": "#/$defs/artifact_or_null" },
        "approved_linearts_dir": { "$ref": "#/$defs/artifact" }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_pdf", "standard_mark_pdf", "manifest"],
      "properties": {
        "preview_pdf": { "$ref": "#/$defs/artifact_or_null" },
        "standard_mark_pdf": { "$ref": "#/$defs/artifact_or_null" },
        "manifest": { "$ref": "#/$defs/artifact_or_null" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_items",
        "generated_items",
        "skipped_items",
        "approved_linearts",
        "missing_linearts",
        "warning_count",
        "error_count"
      ],
      "properties": {
        "total_items": { "$ref": "#/$defs/non_negative_integer" },
        "generated_items": { "$ref": "#/$defs/non_negative_integer" },
        "skipped_items": { "$ref": "#/$defs/non_negative_integer" },
        "approved_linearts": { "$ref": "#/$defs/non_negative_integer" },
        "missing_linearts": { "$ref": "#/$defs/non_negative_integer" },
        "warning_count": { "$ref": "#/$defs/non_negative_integer" },
        "error_count": { "$ref": "#/$defs/non_negative_integer" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_approved_lineart_for_standard_pdf", "barcode_source", "layout_control"],
      "properties": {
        "requires_approved_lineart_for_standard_pdf": {
          "type": "boolean",
          "const": true
        },
        "barcode_source": {
          "type": "string",
          "const": "programmatic_ean13"
        },
        "layout_control": {
          "type": "string",
          "const": "programmatic_coordinates"
        }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item_result" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "project_relative_path": {
      "type": "string",
      "minLength": 1
    },
    "artifact_or_null": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/artifact" }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": { "$ref": "#/$defs/project_relative_path" },
        "status": {
          "type": "string",
          "enum": ["expected", "present", "generated", "missing", "skipped", "failed"]
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": { "type": "string" }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "const": "kmt_style_v1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "item_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_no",
        "status",
        "generated_marks",
        "lineart_status",
        "lineart_asset",
        "barcode_status",
        "warnings",
        "errors"
      ],
      "properties": {
        "item_no": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["generated", "preview_only", "skipped", "needs_review", "failed"]
        },
        "generated_marks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["front", "side"]
          },
          "uniqueItems": true
        },
        "lineart_status": {
          "type": "string",
          "enum": ["missing", "pending", "uploaded", "approved", "rejected", "stale"]
        },
        "lineart_asset": {
          "type": ["string", "null"]
        },
        "barcode_status": {
          "type": "string",
          "enum": ["valid", "invalid", "missing"]
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "front": {
              "type": "integer",
              "minimum": 1
            },
            "side": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error", "needs_review"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "item_no": { "type": "string" },
        "field": { "type": "string" },
        "path": { "type": "string" },
        "face": {
          "type": "string",
          "enum": ["front", "side"]
        },
        "component": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sheet": { "type": "string" },
        "row": { "type": "integer" },
        "x_dimension_mm": { "type": "number" },
        "magnification": { "type": "number" },
        "size_mm": { "type": "number" },
        "needed_mm": { "type": "number" },
        "available_mm": { "type": "number" },
        "box_mm": {
          "type": "array",
          "items": { "type": "number" }
        },
        "zone_mm": {
          "type": "array",
          "items": { "type": "number" }
        },
        "safe_area_mm": {
          "type": "array",
          "items": { "type": "number" }
        },
        "rejected_family": { "type": "string" },
        "aspect": { "type": "number" }
      }
    }
  }
}
