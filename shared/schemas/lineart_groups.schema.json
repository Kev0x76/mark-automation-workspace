{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mark-automation.local/schemas/lineart_groups.schema.json",
  "title": "lineart_groups.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "method",
    "scope",
    "policy",
    "summary",
    "groups",
    "review_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "const": "exact_normalized_cn_name_v1"
    },
    "scope": {
      "type": "string",
      "const": "category_evidence_only"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_category_grouping",
        "auto_lineart_reuse",
        "reuse_requires",
        "fuzzy_name_matching"
      ],
      "properties": {
        "auto_category_grouping": {
          "type": "boolean",
          "const": true
        },
        "auto_lineart_reuse": {
          "type": "boolean",
          "const": false
        },
        "reuse_requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fuzzy_name_matching": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_items",
        "grouped_items",
        "category_groups",
        "multi_item_groups",
        "review_items",
        "auto_reuse_groups"
      ],
      "properties": {
        "input_items": { "$ref": "#/$defs/non_negative_integer" },
        "grouped_items": { "$ref": "#/$defs/non_negative_integer" },
        "category_groups": { "$ref": "#/$defs/non_negative_integer" },
        "multi_item_groups": { "$ref": "#/$defs/non_negative_integer" },
        "review_items": { "$ref": "#/$defs/non_negative_integer" },
        "auto_reuse_groups": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "manual_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "review_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_item" }
    }
  },
  "$defs": {
    "non_negative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_no", "cn_name", "normalization_changed"],
      "properties": {
        "item_no": {
          "type": "string",
          "minLength": 1
        },
        "cn_name": {
          "type": "string",
          "minLength": 1
        },
        "normalization_changed": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "member_count", "original_cn_names", "normalization"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["exact_normalized_cn_name_v1", "manual_selection_v1"]
        },
        "member_count": {
          "type": "integer",
          "minimum": 1
        },
        "original_cn_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "normalization": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "normalized_cn_name",
        "members",
        "evidence",
        "variant_evidence_status",
        "reuse_decision",
        "auto_lineart_reuse"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "pattern": "^(cn|manual)-[0-9a-f]{16}$"
        },
        "normalized_cn_name": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/member" }
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "variant_evidence_status": {
          "type": "string",
          "enum": ["not_applicable_singleton", "missing_from_item_contract"]
        },
        "reuse_decision": {
          "type": "string",
          "enum": ["not_applicable_singleton", "needs_variant_evidence"]
        },
        "auto_lineart_reuse": {
          "type": "boolean",
          "const": false
        },
        "manual_creation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "reason", "created_at"],
          "properties": {
            "reviewer": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "created_at": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_no", "cn_name", "reason"],
      "properties": {
        "item_no": { "type": "string" },
        "cn_name": { "type": "string" },
        "reason": {
          "type": "string",
          "enum": [
            "missing_item_no",
            "duplicate_item_no",
            "missing_cn_name",
            "insufficient_chinese_category_evidence"
          ]
        }
      }
    }
  }
}
