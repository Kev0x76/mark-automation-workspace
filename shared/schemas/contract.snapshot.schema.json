{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract.snapshot.json",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_contract",
    "parser",
    "table",
    "items",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "source_contract": {
      "type": "object",
      "required": ["path", "format", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["xls", "xlsx"] },
        "original_filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "parser": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": ["sheet", "header_row", "columns"],
      "properties": {
        "sheet": { "type": "string", "minLength": 1 },
        "header_start_row": { "type": "integer", "minimum": 1 },
        "header_row": { "type": "integer", "minimum": 1 },
        "columns": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[A-Z]+$" }
        },
        "contract_item_region": {
          "type": "object",
          "required": [
            "method",
            "first_product_row",
            "last_product_row",
            "item_rows",
            "spans",
            "ignored_non_product_rows_count"
          ],
          "properties": {
            "method": { "const": "multi_field_contract_item_region_v1" },
            "first_product_row": { "type": "integer", "minimum": 1 },
            "last_product_row": { "type": "integer", "minimum": 1 },
            "item_rows": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            },
            "spans": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["start_row", "end_row", "item_count"],
                "properties": {
                  "start_row": { "type": "integer", "minimum": 1 },
                  "end_row": { "type": "integer", "minimum": 1 },
                  "item_count": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            },
            "ignored_non_product_rows_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_number", "barcode", "names", "packing_qty", "source"],
        "properties": {
          "item_number": { "type": "string", "minLength": 1 },
          "barcode": { "type": "string" },
          "names": {
            "type": "object",
            "required": ["cn", "it", "es", "en", "pt"],
            "properties": {
              "cn": { "type": "string" },
              "it": { "type": "string" },
              "es": { "type": "string" },
              "en": { "type": "string" },
              "pt": { "type": "string" }
            },
            "additionalProperties": false
          },
          "packing_qty": { "type": ["number", "null"] },
          "source": {
            "type": "object",
            "required": ["row", "cells"],
            "properties": {
              "row": { "type": "integer", "minimum": 1 },
              "cells": {
                "type": "object",
                "additionalProperties": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "integrity": {
      "type": "object",
      "required": ["payload_sha256"],
      "properties": {
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
